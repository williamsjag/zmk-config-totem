            };
            fn5_shift: fn5_shift {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp N5>, <&fn5_gui>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
                keep-mods = <(MOD_LSFT|MOD_RSFT)>;
            };
            fn5_gui: fn5_gui {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp N5>, <&fn5_alt>;
                mods = <(MOD_LGUI|MOD_RGUI)>;
                keep-mods = <(MOD_LGUI|MOD_RGUI)>;
            };
            fn5_alt: fn5_alt {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp N5>, <&fn5_clean>;
                mods = <(MOD_LALT|MOD_RALT)>;
                keep-mods = <(MOD_LALT|MOD_RALT)>;
            };
            fn5_clean: fn5_clean {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp N5>, <&kp F5>;
                mods = <(MOD_LSFT|MOD_RSFT|MOD_LGUI|MOD_RGUI|MOD_LALT|MOD_RALT)>;
            };
            fn6_shift: fn6_shift {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp N6>, <&fn6_gui>;
                mods = <(MOD_LSFT|MOD_RSFT)>;
                keep-mods = <(MOD_LSFT|MOD_RSFT)>;
            };
            fn6_gui: fn6_gui {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&kp N6>, <&fn6_alt>;
                mods = <(MOD_LGUI|MOD_RGUI)>;
